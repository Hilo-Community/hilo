{
  "name": "@hilo/web-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./dist/tailwind.css"
  },
  "dependencies": {
    "@hilo/editor-cm6": "workspace:*",
    "@hilo/protocol-types": "workspace:*",
    "@lezer/cpp": "1.1.6",
    "@lezer/highlight": "1.2.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.17",
    "markdown-it": "15.0.3",
    "shiki": "4.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "@tailwindcss/typography": "0.5.20",
    "tailwindcss": "^4.1.11"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tailwindcss -i ./src/theme/tailwind.css -o ./dist/tailwind.css",
    "build:css": "tailwindcss -i ./src/theme/tailwind.css -o ./dist/tailwind.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --exclude src/cockpit/performance.test.ts && vitest run src/cockpit/performance.test.ts --maxWorkers=1 --no-file-parallelism"
  }
}
